# OpenAI API Key (erforderlich)
OPENAI_API_KEY=sk-your-api-key-here

# Anthropic API Key (optional, aktiviert Claude als Fallback-Provider wenn OpenAI fehlschlägt)
ANTHROPIC_API_KEY=

# Modell-IDs (optional, überschreiben die eingebauten Defaults ohne Code-Deploy)
#
# ACHTUNG vor dem Wechsel: Manche Modelle denken vor der Antwort. Dieses Denken
# verbraucht dasselbe Token-Budget wie die Antwort. Ist LLM_MAX_TOKENS zu klein,
# verbraucht das Denken das Budget und die Antwort bleibt leer oder unvollständig.
#
# Vor dem Wechsel auf ein anderes Modell drei Punkte prüfen:
# 1. Denkt das Modell vor der Antwort? Dann LLM_MAX_TOKENS deutlich erhöhen.
# 2. Akzeptiert das Modell die Parameter max_tokens und temperature?
#    Manche Provider verlangen für denkende Modelle andere Parameternamen.
# 3. Nach dem Wechsel die Logs auf [TRUNCATED] prüfen. Diese Zeile bedeutet:
#    Das Modell erreichte das Limit und die Antwort ist abgeschnitten.
#
# Der Server warnt beim Start, wenn hier ein anderes als das getestete Modell steht.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Antwort-Budget in Tokens (optional, Standard: 4000)
# Gilt für die Analyse- und Rewrite-Endpunkte. Die Textkorrektur-Endpunkte
# nutzen mindestens 3000 bzw. 4000 Tokens, auch wenn hier weniger steht.
LLM_MAX_TOKENS=4000

# Port (optional, Standard: 3000)
PORT=3000
