# OpenAI API Key (erforderlich)
OPENAI_API_KEY=sk-your-api-key-here

# Anthropic API Key (optional, aktiviert Claude als Fallback-Provider wenn OpenAI fehlschlägt)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Modell-IDs (optional, überschreiben die Defaults ohne Code-Deploy)
# ---------------------------------------------------------------------------
#
# Ein Wechsel ist gefahrlos: Lehnt der Provider das Modell ab, schaltet der
# Server auf gpt-4o-mini zurück und schreibt [MODELL] ins Log. Der Betrieb
# bricht also nicht ab, wenn die ID falsch ist.
#
# Der Server sendet an OpenAI: max_tokens, temperature und Structured Outputs
# (response_format mit json_schema, strict). Ein Modell muss alle drei
# unterstützen, sonst greift der Fallback.
#
# Geprüfte Optionen (Stand August 2026):
#
#   gpt-4.1-mini   Default. Schneller als gpt-4o-mini (0,92 s statt 1,07 s bis
#                  zum ersten Token), gleiche Parameter. 0,40 / 1,60 USD je 1M.
#   gpt-4.1-nano   Schnellste und günstigste Option (0,67 s, 0,10 / 0,40 USD).
#                  Kleineres Modell - vor dem Umstieg die Erkennungsqualität
#                  bei semantischen Kategorien prüfen (Gesundheit, Kinder,
#                  Emotionen), die nicht schon per Regex erkannt werden.
#   gpt-4o-mini    Bisheriger Default, weiterhin verfügbar, kein Abschaltdatum.
#                  Dient als Rückfallmodell.
#
# Nicht verwenden:
#
#   gpt-5-mini, gpt-5-nano   Abschaltung am 11.12.2026.
#   Reasoning-Modelle (GPT-5.x, o-Serie)   Verlangen max_completion_tokens
#                  statt max_tokens und lehnen temperature ab, solange
#                  reasoning.effort nicht "none" ist. Beides erfordert eine
#                  Code-Änderung. Dazu kommt die Latenz: gemessen rund 1,7 s
#                  bis zum ersten Token, was den Anwendungsfall "prüfen vor dem
#                  Absenden" unbrauchbar macht.
#
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ---------------------------------------------------------------------------
# Antwort-Budget in Tokens (optional, Standard: 4000)
# ---------------------------------------------------------------------------
# Gilt für die Analyse- und Rewrite-Endpunkte. Die Textkorrektur-Endpunkte
# nutzen mindestens 3000 bzw. 4000 Tokens, auch wenn hier weniger steht.
#
# Denkt ein Modell vor der Antwort, verbraucht dieses Denken dasselbe Budget.
# Der Server meldet abgeschnittene Antworten als [TRUNCATED] im Log.
LLM_MAX_TOKENS=4000

# Port (optional, Standard: 3000)
PORT=3000
